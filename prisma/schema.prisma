  userId String
  user   User @relation("UserSubscription", fields: [userId], references: [id])
  
  // Assinatura
  status        String   @default("active") // active, canceled, expired
  startDate     DateTime @default(now())
  endDate       DateTime?
  canceledAt    DateTime?
  
  // Pagamento
  paymentMethod String?
  lastPayment   DateTime?
  nextPayment   DateTime?
  
  // Relacionamento com sites
  subscriberSites SubscriberSite[] @relation("SiteSubscription")

  @@map("plan_subscriptions")
}

// ========================================
// 📅 AGENDAMENTOS
// ========================================
enum AppointmentStatus {
  SCHEDULED   // Agendado
  CONFIRMED   // Confirmado
  IN_PROGRESS // Em andamento
  COMPLETED   // Concluído
  CANCELED    // Cancelado
  NO_SHOW     // Não compareceu
}

enum AppointmentType {
  MEETING      // Reunião
  VISIT        // Visita
  CALL         // Ligação
  VIDEO_CALL   // Videochamada
  EVENT        // Evento
  TASK         // Tarefa
  OTHER        // Outro
}

model Appointment {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  
  // Informações básicas
  title       String
  description String?  @db.Text
  
  // Data e hora
  startDateTime DateTime
  endDateTime   DateTime
  duration      Int?     // em minutos
  allDay        Boolean  @default(false)
  
  // Status e tipo
  status      AppointmentStatus @default(SCHEDULED)
  type        AppointmentType   @default(MEETING)
  
  // Local
  location    String?
  isOnline    Boolean  @default(false)
  meetingUrl  String?
  
  // Participantes
  clientId    String?
  client      Contact? @relation("AppointmentClient", fields: [clientId], references: [id])
  
  assignedToId String?
  assignedTo   User?   @relation("AppointmentAssignedTo", fields: [assignedToId], references: [id])
  
  // Criador
  createdById String
  createdBy   User @relation("AppointmentCreatedBy", fields: [createdById], references: [id])
  
  // Notificações
  sendReminder    Boolean @default(true)
  reminderMinutes Int?    @default(30)
  
  // Notas
  notes       String?  @db.Text
  
  // Cores personalizadas
  color       String?  @default("#3b82f6")
  
  // WhatsApp Integration
  whatsappChatId String?

  @@map("appointments")
}

// ========================================
// 👥 SISTEMA DE ATENDENTES E MÉTRICAS
// ========================================

// Status de Atendimento
enum AttendanceStatus {
  AGUARDANDO      // Aguardando atendimento
  EM_ANDAMENTO    // Em atendimento
  FINALIZADO      // Atendimento finalizado
  PAUSADO         // Atendimento pausado
}

// Métricas de Atendente
model AttendantMetrics {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  
  // Período da métrica
  date      DateTime @default(now()) // Data do registro
  
  // Métricas de Atendimento
  totalChats          Int @default(0) // Total de chats atendidos
  activeChats         Int @default(0) // Chats ativos agora
  totalMessages       Int @default(0) // Total de mensagens enviadas
  avgResponseTime     Float @default(0) // Tempo médio de resposta (minutos)
  
  // Métricas de Conversão
  totalLeads          Int @default(0) // Leads gerados
  convertedLeads      Int @default(0) // Leads convertidos
  conversionRate      Float @default(0) // Taxa de conversão %
  
  // Métricas de Negócio
  totalQuotes         Int @default(0) // Orçamentos criados
  approvedQuotes      Int @default(0) // Orçamentos aprovados
  totalContracts      Int @default(0) // Contratos fechados
  totalRevenue        Decimal @default(0) @db.Decimal(10, 2) // Receita gerada
  
  // Métricas de Suporte
  totalTickets        Int @default(0) // Tickets criados
  resolvedTickets     Int @default(0) // Tickets resolvidos
  avgResolutionTime   Float @default(0) // Tempo médio de resolução (horas)
  
  // Métricas de Agendamento
  totalSchedules      Int @default(0) // Agendamentos criados
  completedSchedules  Int @default(0) // Agendamentos completados
  
  // Satisfação
  satisfactionScore   Float @default(0) // Score de 0-100
  totalRatings        Int @default(0) // Total de avaliações
  
  // Relacionamento
  attendantId String
  attendant   User @relation("AttendantMetrics", fields: [attendantId], references: [id], onDelete: Cascade)
  
  @@unique([attendantId, date]) // Uma métrica por dia por atendente
  @@map("attendant_metrics")
}

// Atendimentos (relacionamento Contact + Atendente + Status)
model Attendance {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  
  // Status do atendimento
  status          AttendanceStatus @default(AGUARDANDO)
  startedAt       DateTime?
  finishedAt      DateTime?
  pausedAt        DateTime?
  
  // Dados do atendimento
  notes           String? @db.Text
  tags            String[] // Tags do atendimento
  priority        Int @default(1) // 1-5
  
  // WhatsApp Integration
  whatsappChatId  String? // ID do chat do WhatsApp
  
  // Relacionamentos
  contactId String
  contact   Contact @relation("ContactAttendances", fields: [contactId], references: [id], onDelete: Cascade)
  
  attendantId String
  attendant   User @relation("UserAttendances", fields: [attendantId], references: [id])
  
  @@map("attendances")
}

// ========================================
// 🌐 SITES DOS ASSINANTES
// ========================================

enum SiteStatus {
  ACTIVE      // Ativo
  INACTIVE    // Inativo
  EXPIRED     // Expirado
  SUSPENDED   // Suspenso
  PENDING     // Pendente
}

enum SiteConfigType {
  MANUAL      // Configuração manual
  AI          // Configuração por IA
}

enum SiteServerType {
  VIVAOSIM    // Servidor Viva o Sim
  PROPRIO     // Servidor próprio do cliente
}

model SubscriberSite {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  
  // Relacionamento com assinante
  subscriberId String
  subscriber   User @relation("SubscriberSites", fields: [subscriberId], references: [id], onDelete: Cascade)
  
  // Relacionamento com plano e assinatura
  planId String
  plan   Plan @relation("SitePlan", fields: [planId], references: [id])
  
  subscriptionId String
  subscription   PlanSubscription @relation("SiteSubscription", fields: [subscriptionId], references: [id])
  
  // Domínio
  domain       String  @unique // subdominio.vivaosim.com.br
  customDomain String? @unique // dominio-proprio.com.br (opcional)
  
  // Status e datas
  status         SiteStatus @default(PENDING)
  activatedAt    DateTime?
  expiresAt      DateTime?
  suspendedAt    DateTime?
  suspendedReason String?
  
  // Configuração
  configType     SiteConfigType @default(MANUAL)
  primaryColor   String?        @default("#FF6B35") // Cor principal do site
  secondaryColor String?        @default("#004E89") // Cor secundária
  segment        String?        // Segmento: casamento, 15anos, corporativo, etc
  
  // Servidor
  serverType     SiteServerType @default(VIVAOSIM)
  serverUrl      String?        // URL do servidor próprio (se aplicável)
  
  // Estatísticas
  totalVisitors  Int @default(0)
  totalConversions Int @default(0)
  
  // Configurações adicionais (JSON)
  settings       Json?          // Configurações extras em JSON
  
  @@map("subscriber_sites")
}

