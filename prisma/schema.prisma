// ========================================
// 🤖 AGENTES IA
// ========================================
enum AgentStatus {
  ACTIVE
  INACTIVE
  TRAINING
  ERROR
}

model Agent {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Dados básicos
  name        String
  description String
  model       String // gpt-4, claude-3, gemini-pro, etc
  niche       String // vendas, suporte, marketing, etc
  role        String // assistant, consultant, specialist, etc
  status      AgentStatus @default(ACTIVE)
  
  // Campo para vincular com WhatsApp/Chat externo
  chatId      String?  // ID do chat externo (WhatsApp, etc)
  
  // Prompt e configuração
  prompt      String  @db.Text
  temperature Float?  @default(0.7)
  maxTokens   Int?    @default(2000)
  
  // Controle de acesso
  userTypes       Json // ['atendentes', 'admin', 'assinante']
  activationModes Json // ['chat', 'kanban', 'columns']
  
  // Estatísticas de uso
  totalInteractions Int     @default(0)
  successRate       Float   @default(0)
  avgResponseTime   Float   @default(0)
  lastUsed          DateTime?
  
  // Integrações
  integrations Json? // { chat: {...}, kanban: {...}, columns: {...} }
  
  // Relacionamentos
  createdById String
  createdBy   User @relation("UserCreatedAgents", fields: [createdById], references: [id])

  @@map("agents")
}

// ========================================
// 📝 BLOG POSTS
// ========================================
enum PostStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

enum PostVisibility {
  PUBLIC
  PRIVATE
  UNLISTED
}

model BlogPost {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  
  // Conteúdo
  title       String
  slug        String   @unique
  excerpt     String?  // Resumo curto
  content     String   @db.Text // Conteúdo completo (Markdown/HTML)
  coverImage  String?  // URL da imagem de capa
  
  // Metadados
  status      PostStatus     @default(DRAFT)
  visibility  PostVisibility @default(PUBLIC)
  publishedAt DateTime?
  
  // SEO
  metaTitle       String?
  metaDescription String?
  metaKeywords    String?
  
  // Estatísticas
  viewCount    Int @default(0)
  likeCount    Int @default(0)
  commentCount Int @default(0)
  
  // Relacionamentos
  authorId String
  author   User @relation("BlogPostAuthor", fields: [authorId], references: [id])
  
  categories BlogPostCategory[]
  tags       BlogPostTag[]
  comments   BlogComment[]

  @@map("blog_posts")
}

model BlogCategory {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  
  name        String @unique
  slug        String @unique
  description String?
  color       String @default("#3b82f6")
  
  posts BlogPostCategory[]

  @@map("blog_categories")
}

model BlogPostCategory {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())
  
  postId     String
  post       BlogPost @relation(fields: [postId], references: [id], onDelete: Cascade)
  
  categoryId String
  category   BlogCategory @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  @@unique([postId, categoryId])
  @@map("blog_post_categories")
}

model BlogTag {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())
  
  name  String @unique
  slug  String @unique
  color String @default("#6b7280")
  
  posts BlogPostTag[]

  @@map("blog_tags")
}

model BlogPostTag {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())
  
  postId String
  post   BlogPost @relation(fields: [postId], references: [id], onDelete: Cascade)
  
  tagId  String
  tag    BlogTag @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@unique([postId, tagId])
  @@map("blog_post_tags")
}

model BlogComment {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  
  content   String   @db.Text
  isApproved Boolean @default(false)
  
  postId String
  post   BlogPost @relation(fields: [postId], references: [id], onDelete: Cascade)
  
  authorName  String
  authorEmail String
  
  parentId String?
  parent   BlogComment? @relation("CommentReplies", fields: [parentId], references: [id])
  replies  BlogComment[] @relation("CommentReplies")

  @@map("blog_comments")
}

// ========================================
// 📦 PLANOS DE ASSINATURA
// ========================================
enum PlanStatus {
  ACTIVE
  INACTIVE
  ARCHIVED
}

enum PlanPeriod {
  MONTHLY
  QUARTERLY
  SEMIANNUAL
  ANNUAL
  LIFETIME
}

model Plan {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  
  // Informações Básicas
  name        String
  slug        String   @unique
  description String?  @db.Text
  
  // Preço
  price       Decimal  @db.Decimal(10, 2)
  period      PlanPeriod @default(MONTHLY)
  
  // Configurações
  status      PlanStatus @default(ACTIVE)
  isFeatured  Boolean @default(false)
  isPopular   Boolean @default(false)
  
  // Limites
  maxUsers        Int?
  maxProjects     Int?
  maxStorage      Int?  // em GB
  maxApiCalls     Int?
  
  // Recursos (JSON)
  features        Json  // Array de features
  
  // Ordem de exibição
  displayOrder    Int   @default(0)
  
  // Relacionamentos
  createdById String
  createdBy   User @relation("PlanCreatedBy", fields: [createdById], references: [id])
  
  subscriptions PlanSubscription[]

  @@map("plans")
}

model PlanSubscription {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  
  // Relacionamentos
  planId String
  plan   Plan @relation(fields: [planId], references: [id])
  
  userId String
  user   User @relation("UserSubscription", fields: [userId], references: [id])
  
  // Assinatura
  status        String   @default("active") // active, canceled, expired
  startDate     DateTime @default(now())
  endDate       DateTime?
  canceledAt    DateTime?
  
  // Pagamento
  paymentMethod String?
  lastPayment   DateTime?
  nextPayment   DateTime?

  @@map("plan_subscriptions")
}

// ========================================
// 📅 AGENDAMENTOS
// ========================================
enum AppointmentStatus {
  SCHEDULED   // Agendado
  CONFIRMED   // Confirmado
  IN_PROGRESS // Em andamento
  COMPLETED   // Concluído
  CANCELED    // Cancelado
  NO_SHOW     // Não compareceu
}

enum AppointmentType {
  MEETING      // Reunião
  VISIT        // Visita
  CALL         // Ligação
  VIDEO_CALL   // Videochamada
  EVENT        // Evento
  TASK         // Tarefa
  OTHER        // Outro
}

model Appointment {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  
  // Informações básicas
  title       String
  description String?  @db.Text
  
  // Data e hora
  startDateTime DateTime
  endDateTime   DateTime
  duration      Int?     // em minutos
  allDay        Boolean  @default(false)
  
  // Status e tipo
  status      AppointmentStatus @default(SCHEDULED)
  type        AppointmentType   @default(MEETING)
  
  // Local
  location    String?
  isOnline    Boolean  @default(false)
  meetingUrl  String?
  
  // Participantes
  clientId    String?
  client      Contact? @relation("AppointmentClient", fields: [clientId], references: [id])
  
  assignedToId String?
  assignedTo   User?   @relation("AppointmentAssignedTo", fields: [assignedToId], references: [id])
  
  // Criador
  createdById String
  createdBy   User @relation("AppointmentCreatedBy", fields: [createdById], references: [id])
  
  // Notificações
  sendReminder    Boolean @default(true)
  reminderMinutes Int?    @default(30)
  
  // Notas
  notes       String?  @db.Text
  
  // Cores personalizadas
  color       String?  @default("#3b82f6")
  
  // WhatsApp Integration
  whatsappChatId String?

  @@map("appointments")
}

