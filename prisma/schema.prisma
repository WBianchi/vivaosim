enum ExpenseCategory {
  SOM              // Som e DJ
  ILUMINACAO       // Iluminação
  FOTOGRAFIA       // Fotografia
  FILMAGEM         // Filmagem/Vídeo
  DECORACAO        // Decoração
  BUFFET           // Buffet e Catering
  LOCAL            // Aluguel de local
  TRANSPORTE       // Transporte
  SEGURANCA        // Segurança
  LIMPEZA          // Limpeza
  EQUIPAMENTOS     // Equipamentos diversos
  PESSOAL          // Pessoal/Staff
  MARKETING        // Marketing
  ADMINISTRATIVO   // Administrativo
  OUTROS           // Outros
  // Valores antigos (manter para compatibilidade com event_expenses)
  ALIMENTACAO
  MUSICA
  VESTUARIO
  FLORES
  CONVITES
  LEMBRANCINHAS
}

enum ExpenseStatus {
  PENDENTE         // Aguardando pagamento
  PAGO             // Pago
  ATRASADO         // Atrasado
  CANCELADO        // Cancelado
  PARCIAL          // Parcialmente pago
}

enum PaymentMethod {
  DINHEIRO
  PIX
  CARTAO_CREDITO
  CARTAO_DEBITO
  TRANSFERENCIA
  BOLETO
  CHEQUE
  OUTROS
}

