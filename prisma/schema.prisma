  descricaoEvento String?
  
  // Domínio e Identidade
  subdominio      String  @unique // cliente.vivaosim.com.br
  dominioCustom   String? @unique // opcional: cliente.com.br
  
  // Design e Personalização
  logo            String? // URL da logo
  banner          String? // URL do banner principal
  corPrimaria     String  @default("#FF6B35")
  corSecundaria   String  @default("#004E89")
  corDestaque     String  @default("#FFC857")
  fontePrimaria   String  @default("Inter")
  fonteSecundaria String  @default("Playfair Display")
  
  // Configurações de UI
  roundButtons    Int     @default(8) // Border radius dos botões (px)
  roundSessoes    Int     @default(12) // Border radius das seções
  roundColunas    Int     @default(8) // Border radius das colunas/cards
  
  // Status
  status          ClientSiteStatus @default(RASCUNHO)
  publicadoEm     DateTime?
  
  // Estatísticas
  visualizacoes   Int @default(0)
  totalPresentes  Int @default(0)
  
  // Relacionamentos
  produtos        ProdutoCliente[]
  convidados      ConvidadoCliente[]
  custosDespesas  CustoDespesa[]
  recebimentos    RecebimentoPresente[]
  
  // Gestão Financeira
  // suppliers       Supplier[]
  // expenses        Expense[]
  // costEstimates   CostEstimate[]
  
  // Configurações extras (JSON)
  configuracoes   Json? // Configurações adicionais flexíveis
  
  @@map("cliente_sites")
}

model ProdutoCliente {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  
  // Relacionamento com o site
  siteId String
  site   ClientSite @relation(fields: [siteId], references: [id], onDelete: Cascade)
  
  // Informações do Produto/Presente
  nome        String
  descricao   String?
  imagem      String? // URL da imagem
  preco       Decimal @db.Decimal(10, 2)
  quantidade  Int     @default(1) // Quantos podem ser comprados
  vendidos    Int     @default(0) // Quantos já foram comprados
  
  // Categoria
  categoria   String? // Ex: Eletrodomésticos, Decoração, Experiências
  
  // Status
  ativo       Boolean @default(true)
  destaque    Boolean @default(false)
  
  // Relacionamentos
  itens       ItemProdutoCliente[]
  recebimentos RecebimentoPresente[]
  
  @@map("produtos_cliente")
}

model ItemProdutoCliente {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())
  
  // Relacionamento com produto
  produtoId String
  produto   ProdutoCliente @relation(fields: [produtoId], references: [id], onDelete: Cascade)
  
  // Detalhes do item (se produto tem variações)
  nome      String
  valor     Decimal @db.Decimal(10, 2)
  
  @@map("itens_produtos_cliente")
}

model ConvidadoCliente {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  
  // Relacionamento com o site
  siteId String
  site   ClientSite @relation(fields: [siteId], references: [id], onDelete: Cascade)
  
  // Dados do Convidado
  nome            String
  email           String?
  telefone        String?
  numeroConvites  Int     @default(1) // Quantas pessoas o convite inclui
  
  // Confirmação
  status          ConvidadoStatus @default(PENDENTE)
  confirmedAt     DateTime?
  observacoes     String?
  
  // Controle de Presença
  presenteEvento  Boolean @default(false) // Compareceu ao evento
  checkinAt       DateTime?
  
  @@map("convidados_cliente")
}

model CustoDespesa {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  
  // Relacionamento com o site/evento
  siteId String
  site   ClientSite @relation(fields: [siteId], references: [id], onDelete: Cascade)
  
  // Responsável pelo lançamento
  lancadoPorId String?
  lancadoPor   User?   @relation("CustoDespesaLancador", fields: [lancadoPorId], references: [id])
  
  // Informações do Custo
  tipo        TipoCustoDespesa
  descricao   String
  fornecedor  String?
  valor       Decimal @db.Decimal(10, 2)
  
  // Pagamento
  pago        Boolean @default(false)
  dataPagamento DateTime?
  formaPagamento String? // Cartão, PIX, Dinheiro, etc
  
  // Anexos
  comprovante String? // URL do comprovante/nota
  
  // Observações
  observacoes String?
  
  @@map("custos_despesas")
}

model RecebimentoPresente {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  
  // Relacionamento com o site
  siteId String
  site   ClientSite @relation(fields: [siteId], references: [id], onDelete: Cascade)
  
  // Produto comprado
  produtoId String
  produto   ProdutoCliente @relation(fields: [produtoId], references: [id])
  
  // Dados do comprador/presenteador
  nomeComprador  String
  emailComprador String?
  telefoneComprador String?
  mensagem       String? // Mensagem do presenteador
  
  // Pagamento
  valor          Decimal @db.Decimal(10, 2)
  statusPagamento String @default("PENDENTE") // PENDENTE, PAGO, CANCELADO
  metodoPagamento String? // PIX, Cartão, etc
  transacaoId    String? // ID da transação no gateway de pagamento
  
  // Datas
  pagoEm         DateTime?
  
  @@map("recebimentos_presentes")
}

