  FOTOGRAFIA
  MUSICA_DJ
  LOCAL
  CONVITES
  VESTUARIO
  TRANSPORTE
  HOSPEDAGEM
  OUTRO
}

model ClientSite {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  
  // Relacionamento com Contact (cliente via WhatsApp)
  contactId String  @unique
  contact   Contact @relation("ClientSiteContact", fields: [contactId], references: [id], onDelete: Cascade)
  
